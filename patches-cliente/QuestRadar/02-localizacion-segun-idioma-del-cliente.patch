+    ["desactive"] = "disabled",
+    ["detecte"] = "detected",
+    ["pas de reponse"] = "no response",
+    ["0 POI: si la carte du monde n affiche pas non plus de pastilles numerotees, la table quest_poi du monde est vide cote serveur."] = "0 POI: if the world map does not show numbered markers either, the world quest_poi table is empty on the server.",
+    ["active."] = "enabled.",
+    ["desactive."] = "disabled.",
+    ["quetes terminees: %s"] = "completed quests: %s",
+    ["affichees"] = "shown",
+    ["masquees"] = "hidden",
+    ["seules les quetes suivies sont affichees"] = "only tracked quests are shown",
+    ["toutes les quetes de la zone sont affichees"] = "all the quests in the zone are shown",
+    ["module serveur: %s"] = "server module: %s",
+    ["utilise si present"] = "used if present",
+    ["ignore"] = "ignored",
+    ["objectifs hors de portee (colles au bord): %s"] = "out-of-range objectives (stuck to the edge): %s",
+    ["affiches"] = "shown",
+    ["masques"] = "hidden",
+    ["echelle des icones = %s"] = "icon scale = %s",
+    ["echelle: une valeur entre 0.5 et 3"] = "scale: a value between 0.5 and 3",
+}
+
+local ES = {
+    ["Objectifs de quete sur le minimap. Ces reglages sont aussi accessibles via /qr."] = "Objetivos de misión en el minimapa. Estos ajustes también están disponibles con /qr.",
+    ["Activer QuestRadar"] = "Activar QuestRadar",
+    ["Affiche ou masque completement les icones d'objectifs."] = "Muestra u oculta por completo los iconos de objetivos.",
+    ["Limiter aux quetes suivies"] = "Limitar a las misiones seguidas",
