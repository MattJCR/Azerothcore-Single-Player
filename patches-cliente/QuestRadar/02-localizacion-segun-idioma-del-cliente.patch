+-- QuestRadar - Locale.lua
+--
+-- Los textos del addon están escritos en francés (el autor original). Aquí se
+-- traducen al español (clientes esES/esMX) y al inglés (cualquier otro cliente
+-- que no sea frFR); un cliente frFR ve el texto original. La clave es el
+-- literal francés tal como aparece en el código; lo que no tenga traducción se
+-- muestra tal cual, así que nunca queda un texto vacío.
+--
+-- Uso: local L = QuestRadar_L ; L("texto en francés")
+-- Los textos con valores van como formato (%s, %.1f) y se rellenan con string.format.
+
+local locale = GetLocale()
+
+local EN = {
+    ["Objectifs de quete sur le minimap. Ces reglages sont aussi accessibles via /qr."] = "Quest objectives on the minimap. These settings are also available through /qr.",
