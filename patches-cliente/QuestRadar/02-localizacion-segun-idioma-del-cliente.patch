+    ["carte: continent=%s zone=%s (%s)"] = "mapa: continente=%s zona=%s (%s)",
+    ["quetes=%s | objectifs annonces=%s | icones placees=%s | filtre=%s"] = "misiones=%s | objetivos anunciados=%s | iconos colocados=%s | filtro=%s",
+    ["quetes suivies"] = "misiones seguidas",
+    ["toutes"] = "todas",
+    ["source=%s | module serveur=%s"] = "fuente=%s | módulo del servidor=%s",
+    ["desactive"] = "desactivado",
+    ["detecte"] = "detectado",
+    ["pas de reponse"] = "sin respuesta",
+    ["0 POI: si la carte du monde n affiche pas non plus de pastilles numerotees, la table quest_poi du monde est vide cote serveur."] = "0 POI: si el mapa del mundo tampoco muestra marcas numeradas, la tabla quest_poi del mundo está vacía en el servidor.",
+    ["active."] = "activado.",
+    ["desactive."] = "desactivado.",
+    ["quetes terminees: %s"] = "misiones terminadas: %s",
+    ["affichees"] = "mostradas",
+    ["masquees"] = "ocultas",
+    ["seules les quetes suivies sont affichees"] = "sólo se muestran las misiones seguidas",
+    ["toutes les quetes de la zone sont affichees"] = "se muestran todas las misiones de la zona",
+    ["module serveur: %s"] = "módulo del servidor: %s",
+    ["utilise si present"] = "se usa si está presente",
+    ["ignore"] = "ignorado",
+    ["objectifs hors de portee (colles au bord): %s"] = "objetivos fuera de alcance (pegados al borde): %s",
+    ["affiches"] = "mostrados",
+    ["masques"] = "ocultos",
+    ["echelle des icones = %s"] = "escala de los iconos = %s",
+    ["echelle: une valeur entre 0.5 et 3"] = "escala: un valor entre 0.5 y 3",
+}
+
+local dictionary
+if locale == "frFR" then
+    dictionary = nil
+elseif locale == "esES" or locale == "esMX" then
+    dictionary = ES
+else
+    dictionary = EN
+end
+
+function QuestRadar_L(text)
+    return (dictionary and dictionary[text]) or text
+end
