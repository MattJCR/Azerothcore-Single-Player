+    ["Affiche l'icone de rendu (?) pour les quetes pretes a etre rendues."] = "Shows the turn-in icon (?) for quests that are ready to be handed in.",
+    ["Afficher les objectifs hors de portee"] = "Show out-of-range objectives",
+    ["Les objectifs trop loin se collent au bord du minimap, legerement attenues."] = "Objectives that are too far away stick to the edge of the minimap, slightly dimmed.",
+    ["Utiliser le module serveur si present"] = "Use the server module if present",
+    ["Avec le module mod-quest-radar sur le royaume : une icone par objectif au lieu d'une par quete. Sans lui, aucun effet."] = "With the mod-quest-radar module on the realm: one icon per objective instead of one per quest. Without it, it has no effect.",
+    ["Taille des icones : %.1f"] = "Icon size: %.1f",
+    ["|cffff4040!Astrolabe introuvable|r - Interface\\AddOns\\!Astrolabe doit etre present et active."] = "|cffff4040!Astrolabe not found|r - Interface\\AddOns\\!Astrolabe must be present and enabled.",
+    ["v%s | actif=%s | !Astrolabe=%s | echelle=%s"] = "v%s | enabled=%s | !Astrolabe=%s | scale=%s",
+    ["absent"] = "missing",
+    ["carte: continent=%s zone=%s (%s)"] = "map: continent=%s zone=%s (%s)",
