+++ b/b/GuildLevels/Locale.lua
@@ -0,0 +1,56 @@
+-- GuildLevels - Locale.lua
+--
+-- Los textos del addon están escritos en inglés (el autor original). Aquí se
+-- traducen al español para los clientes esES/esMX; cualquier otro cliente ve el
+-- original. La clave es el literal inglés tal como aparece en el código; lo que
+-- no tenga traducción se muestra tal cual, así que nunca queda un texto vacío.
+--
+-- Uso: local L = GuildLevels_L ; L("English text")
+-- Los textos con valores van como formato (%s, %d) y se rellenan con string.format.
+
+local locale = GetLocale()
+
+local ES = {
+    ["Guild Levels"] = "Niveles de hermandad",
+    ["Guild"] = "Hermandad",
+    ["No guild progression\n(not in a guild, or the server feature is off)."] = "Sin progresión de hermandad\n(no estás en una hermandad, o la función está apagada en el servidor).",
+    ["%s\nLevel %d / 25 (%d%% to next)\nToday: %s   Week: %s"] = "%s\nNivel %d / 25 (%d%% al siguiente)\nHoy: %s   Semana: %s",
+    ["|cffeda55fClick|r to open the panel."] = "|cffeda55fClic|r para abrir el panel.",
+    ["Perks (Cataclysm-style)"] = "Ventajas (al estilo Cataclismo)",
+    ["No guild progression (not in a guild or server disabled)."] = "Sin progresión de hermandad (no estás en una hermandad o el servidor la tiene desactivada).",
+    ["Guild Levels — %s"] = "Niveles de hermandad — %s",
+    ["Level |cffffffff%d|r / 25   (guild id %u)"] = "Nivel |cffffffff%d|r / 25   (id de hermandad %u)",
+    ["XP %s / %s in this level   (today %s / week %s)"] = "XP %s / %s en este nivel   (hoy %s / semana %s)",
+    ["(locked) "] = "(bloqueada) ",
+    ["Lv"] = "Nv",
+    ["Fast Track (rank 1)"] = "Vía rápida (rango 1)",
+    ["+5% experience from monsters and quests."] = "+5% de experiencia de monstruos y misiones.",
+    ["Fast Track (rank 2)"] = "Vía rápida (rango 2)",
+    ["Additional +5% experience."] = "+5% de experiencia adicional.",
+    ["Mount Up"] = "Montar",
+    ["Increases mounted movement speed by 10%."] = "Aumenta un 10% la velocidad de movimiento a lomos de montura.",
+    ["Mr. Popularity (r1)"] = "Popular (r1)",
+    ["+5% reputation from monsters and quests."] = "+5% de reputación de monstruos y misiones.",
+    ["Cash Flow (rank 1)"] = "Flujo de caja (rango 1)",
+    ["Guild bank receives 5% of looted enemy money."] = "El banco de hermandad recibe el 5% del dinero saqueado a los enemigos.",
+    ["Working Overtime"] = "Horas extra",
+    ["10% chance for an extra profession skill gain."] = "10% de probabilidad de ganar un punto extra de habilidad de profesión.",
+    ["Cash Flow (rank 2)"] = "Flujo de caja (rango 2)",
+    ["Guild bank receives 10% of looted enemy money."] = "El banco de hermandad recibe el 10% del dinero saqueado a los enemigos.",
+    ["Mr. Popularity (r2)"] = "Popular (r2)",
+    ["Additional +5% reputation."] = "+5% de reputación adicional.",
+    ["Reinforce"] = "Reforzar",
+    ["Reduces death durability loss for equipped gear."] = "Reduce la pérdida de durabilidad por muerte del equipo puesto.",
+    ["Honorable Mention"] = "Mención honorífica",
+    ["Bonus honor from PvP kills."] = "Honor adicional por las muertes en JcJ.",
+    ["Mobile Banking"] = "Banca móvil",
+    ["Grants a spell that summons a temporary guild bank."] = "Concede un hechizo que invoca un banco de hermandad temporal.",
+    ["Mass Resurrection"] = "Resurrección en masa",
+    ["Grants a spell that resurrects nearby dead guild group members."] = "Concede un hechizo que resucita a los miembros muertos de tu grupo de hermandad que estén cerca.",
+}
+
+local dictionary = (locale == "esES" or locale == "esMX") and ES or nil
+
+function GuildLevels_L(text)
+    return (dictionary and dictionary[text]) or text
+end
