+    // FillQuestLoot builds this list for party members present at the kill.
+    // The shared LootItem row must remain until every personal copy is taken.
+    QuestItem* GetUnlootedQuestCopy(Loot* loot, Player* player, size_t sourceIndex)
+    {
+        auto const& copies = loot->GetPlayerQuestItems();
+        auto playerCopies = copies.find(player->GetGUID());
+        if (playerCopies == copies.end() || !playerCopies->second)
+            return nullptr;
+
+        for (QuestItem& copy : *playerCopies->second)
+            if (copy.index == sourceIndex && !copy.is_looted)
+                return &copy;
+
+        return nullptr;
+    }
 }
 
