@@ -15,7 +15,22 @@
 #include "CreatureAI.h"
 #include "guildhouse.h"
 
-int GuildHouseInnKeeper, GuildHouseBank, GuildHouseMailBox, GuildHouseAuctioneer, GuildHouseTrainer, GuildHouseVendor, GuildHouseObject, GuildHousePortal, GuildHouseSpirit, GuildHouseProf, GuildHouseBuyRank;
+int GuildHouseInnKeeper, GuildHouseBank, GuildHouseMailBox, GuildHouseAuctioneer, GuildHouseTrainer, GuildHouseVendor, GuildHouseObject, GuildHousePortal, GuildHouseSpirit, GuildHouseProf, GuildHouseReagentBank, GuildHouseBuyRank;
+
+// SP07: Ling, the reagent banker of mod-reagent-bank. That module ships the NPC
+// and its script; here he is only placed in the house if the module is active.
+constexpr uint32 GUILDHOUSE_REAGENT_BANKER = 290011;
+
+// Disabling mod-reagent-bank only clears the script name of the template and removes
+// the spawns (cleanup_disabled_module_db), so the template alone does not prove the
+// module is active: require its script too.
+static bool GuildHouseReagentBankOffered()
+{
+    if (GuildHouseReagentBank < 0)
+        return false;
+    CreatureTemplate const* banker = sObjectMgr->GetCreatureTemplate(GUILDHOUSE_REAGENT_BANKER);
+    return banker && sObjectMgr->GetScriptName(banker->ScriptID) == "npc_reagent_banker";
+}
 
