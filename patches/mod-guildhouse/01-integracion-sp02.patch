+uint32 GetGuildHousePhase(uint32 guildId)
+{
+    if (!guildId)
+        return 0;
+    QueryResult result = CharacterDatabase.Query("SELECT `phase` FROM `guild_house` WHERE `guild`={}", guildId);
+    return result ? result->Fetch()[0].Get<uint32>() : 0;
+}
+
+// Guests following an owner into the island use the group leader's house.
+// Query the guild by GUID so this hook never reads a player on another map.
+static uint32 GetAccessibleGuildHousePhase(Player* player)
+{
+    if (!player)
+        return 0;
+    if (uint32 own = GetGuildHousePhase(player->GetGuildId()))
+        return own;
+    Group* group = player->GetGroup();
+    if (!group || group->GetLeaderGUID() == player->GetGUID())
+        return 0;
+    QueryResult result = CharacterDatabase.Query(
+        "SELECT gh.`phase` FROM `guild_member` gm JOIN `guild_house` gh "
+        "ON gh.`guild`=gm.`guildid` WHERE gm.`guid`={}",
+        group->GetLeaderGUID().GetCounter());
+    return result ? result->Fetch()[0].Get<uint32>() : 0;
+}
+
+static uint32 AllocateGuildHousePhase()
+{
+    uint32 used = 0;
+    if (QueryResult result = CharacterDatabase.Query("SELECT `phase` FROM `guild_house`"))
+    {
+        do
+        {
+            used |= result->Fetch()[0].Get<uint32>();
+        } while (result->NextRow());
+    }
+    for (uint32 bit = 16; bit <= 30; ++bit)
+    {
+        uint32 phase = uint32(1) << bit;
+        if (!(used & phase))
+            return phase;
+    }
+    return 0;
+}
+
+static bool RemoveTrackedGuildHouse(uint32 guildId)
+{
+    if (!GetGuildHousePhase(guildId))
+        return false;
+
+    // Only spawns created by this module are removed. Other content can share
+    // the map or a phase bit and must survive a house sale or guild disband.
+    Map* map = sMapMgr->FindMap(1, 0);
+    if (QueryResult result = WorldDatabase.Query("SELECT `kind`, `guid` FROM `mod_guildhouse_owned_spawn` WHERE `guild`={}", guildId))
+    {
+        do
+        {
+            Field* fields = result->Fetch();
+            uint8 kind = fields[0].Get<uint8>();
+            uint32 guid = fields[1].Get<uint32>();
+            if (kind == 1)
+            {
+                std::vector<Creature*> loaded;
+                if (map)
+                {
+                    auto bounds = map->GetCreatureBySpawnIdStore().equal_range(guid);
+                    for (auto itr = bounds.first; itr != bounds.second; ++itr)
+                        loaded.push_back(itr->second);
+                }
+                for (Creature* creature : loaded)
+                {
+                    creature->SetRespawnTime(0);
+                    creature->CombatStop();
+                    creature->DeleteFromDB();
+                    creature->AddObjectToRemoveList();
+                }
+                if (loaded.empty())
+                {
+                    sObjectMgr->DeleteCreatureData(guid);
+                    WorldDatabase.Query("DELETE FROM `creature` WHERE `guid`={}", guid);
+                }
+            }
+            else if (kind == 2)
+            {
+                std::vector<GameObject*> loaded;
+                if (map)
+                {
+                    auto bounds = map->GetGameObjectBySpawnIdStore().equal_range(guid);
+                    for (auto itr = bounds.first; itr != bounds.second; ++itr)
+                        loaded.push_back(itr->second);
+                }
+                for (GameObject* object : loaded)
+                {
+                    object->SetRespawnTime(0);
+                    object->Delete();
+                    object->DeleteFromDB();
+                }
+                if (loaded.empty())
+                {
+                    sObjectMgr->DeleteGOData(guid);
+                    WorldDatabase.Query("DELETE FROM `gameobject` WHERE `guid`={}", guid);
+                }
+            }
+        } while (result->NextRow());
+    }
+    WorldDatabase.Query("DELETE FROM `mod_guildhouse_owned_spawn` WHERE `guild`={}", guildId);
+    CharacterDatabase.Query("DELETE FROM `guild_house` WHERE `guild`={}", guildId);
+    return !GetGuildHousePhase(guildId);
+}
+
+// The independent stone, the seller and the command all cast this one spell.
+// The DBC gives it a 10-second cast and a 30-minute cooldown, separate from
+// Hearthstone (8690). Its only effect is dummy, handled here.
+class GuildHousePortalGuard : public GameObjectScript
+{
+public:
+    GuildHousePortalGuard() : GameObjectScript("GuildHousePortalGuard") {}
+
+    bool OnGossipHello(Player* player, GameObject* go) override
+    {
+        if (!player || !go ||
+            go->GetPhaseMask() != GetAccessibleGuildHousePhase(player))
+            return true;
+
+        uint32 entry = go->GetEntry();
+        if (((entry >= 500000 && entry <= 500003) && player->GetTeamId() != TEAM_ALLIANCE) ||
+            ((entry >= 500004 && entry <= 500007) && player->GetTeamId() != TEAM_HORDE))
+        {
+            ChatHandler(player->GetSession()).SendSysMessage("Este portal pertenece a la otra facción.");
+            return true;
+        }
+
+#ifdef GUILDHOUSE_WITH_PROGRESSION
+        if (sIndividualProgression->enabled &&
+            ((entry == 500008 && sIndividualProgression->GetPlayerProgressionFromQuests(player) < 8) ||
+             (entry == 500009 && sIndividualProgression->GetPlayerProgressionFromQuests(player) < 13)))
+        {
+            ChatHandler(player->GetSession()).SendSysMessage("Tu etapa actual aún no permite usar este portal.");
+            return true;
+        }
+#endif
+        return false;
+    }
+};
+
+class spell_guildhouse_stone : public SpellScript
+{
+    PrepareSpellScript(spell_guildhouse_stone);
+
+    SpellCastResult CheckCast()
+    {
+        Player* player = GetCaster() ? GetCaster()->ToPlayer() : nullptr;
+        if (!player || !player->IsAlive() || player->IsBeingTeleported() ||
+            player->IsInFlight() || player->GetTransport() || player->GetVehicle() ||
+            player->InBattleground() || player->GetMap()->IsDungeon() ||
+            (player->GetMapId() == 1 && player->GetZoneId() == 876))
+            return SPELL_FAILED_NOT_HERE;
+        if (player->IsInCombat())
+            return SPELL_FAILED_AFFECTING_COMBAT;
+        if (!GetGuildHousePhase(player->GetGuildId()))
+            return SPELL_FAILED_BAD_TARGETS;
+        return SPELL_CAST_OK;
+    }
+
+    void HandleTeleport(SpellEffIndex)
+    {
+        Player* player = GetCaster() ? GetCaster()->ToPlayer() : nullptr;
+        if (!player || !player->IsAlive() || player->IsInCombat() ||
+            player->IsInFlight() || player->GetTransport() || player->GetVehicle())
+            return;
+        QueryResult result = CharacterDatabase.Query("SELECT `map`, `positionX`, `positionY`, `positionZ`, `orientation` FROM `guild_house` WHERE `guild`={}", player->GetGuildId());
+        if (!result)
+            return;
+        Field* fields = result->Fetch();
+        player->TeleportTo(fields[0].Get<uint32>(), fields[1].Get<float>(),
+            fields[2].Get<float>(), fields[3].Get<float>(), fields[4].Get<float>());
+    }
+
+    void Register() override
+    {
+        OnCheckCast += SpellCheckCastFn(spell_guildhouse_stone::CheckCast);
+        OnEffectHitTarget += SpellEffectFn(spell_guildhouse_stone::HandleTeleport, EFFECT_0, SPELL_EFFECT_DUMMY);
+    }
+};
+
+static void GiveGuildHouseStone(Player* player)
+{
+    if (!player || !player->GetSession() || player->GetSession()->IsHeadless() ||
+        !GetGuildHousePhase(player->GetGuildId()) || player->HasItemCount(600001, 1, true))
+        return;
+    if (!player->AddItem(600001, 1))
+        ChatHandler(player->GetSession()).SendSysMessage("Deja un hueco en la bolsa y pide tu piedra de la sede al vendedor.");
+}
