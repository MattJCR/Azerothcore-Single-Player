+    // was previously loaded only at startup/reload, so bracket bounds went
+    // stale and kept the old, wider cap. Cheap to redo every pass.
+    LoadConfig();
+
     LoadSocialFriendList();

     if (sPlayerbotAIConfig.levelBracketsDynamicDistribution)
