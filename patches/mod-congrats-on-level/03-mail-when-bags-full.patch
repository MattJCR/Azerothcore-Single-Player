+// Entrega un objeto del premio. Si cabe, a la bolsa; si no, por correo.
+// El modulo original lo daba con AddItem y, con la bolsa llena, se perdia
+// ("The player forfeits the rewards if their bags are full", dice su README).
+// Con varias bolsas por nivel eso pasaria tarde o temprano.
+static void giveItem(Player* player, uint32 itemId)
+{
+    if (!sObjectMgr->GetItemTemplate(itemId))
+    {
+        LOG_ERROR("module", "[congrats-on-level] el objeto {} de la tabla de recompensas (nivel {}) no existe en item_template", itemId, player->GetLevel());
+        return;
+    }
+
+    ItemPosCountVec dest;
+    if (player->CanStoreNewItem(NULL_BAG, NULL_SLOT, dest, itemId, 1) == EQUIP_ERR_OK)
+    {
+        player->AddItem(itemId, 1);
+        return;
+    }
+
+    Item* item = Item::CreateItem(itemId, 1, player);
+    if (!item)
+        return;
+
+    LocaleConstant loc = player->GetSession()->GetSessionDbLocaleIndex();
+    bool es = (loc == LOCALE_esES || loc == LOCALE_esMX);
+    std::string subject = (es ? "Recompensa del nivel " : "Level ") + std::to_string(player->GetLevel()) + (es ? "" : " reward");
+    std::string body = es
+        ? "No cabia en tus bolsas al subir de nivel, asi que te lo mandamos por correo."
+        : "It did not fit in your bags when you leveled up, so here it is by mail.";
+
+    // Lo mismo que hace el comando .send items: guardar el objeto en la
+    // transaccion y mandarlo con el remitente del propio jugador.
+    CharacterDatabaseTransaction trans = CharacterDatabase.BeginTransaction();
+    item->SaveToDB(trans);
+    MailDraft(subject, body)
+        .AddItem(item)
+        .SendMailTo(trans, MailReceiver(player, player->GetGUID().GetCounter()),
+                    MailSender(MAIL_NORMAL, player->GetGUID().GetCounter(), MAIL_STATIONERY_GM));
+    CharacterDatabase.CommitTransaction(trans);
+}
