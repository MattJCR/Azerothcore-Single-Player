+        // bots es ruido continuo y oro regalado: Congrats.IgnoreBots.
+        if (col.ignoreBots && player->GetSession() && player->GetSession()->IsHeadless())
+            return;
+
         // If enabled...
         if (col.congratsEnable)
         {
@@ -192,8 +200,10 @@
                 sWorldSessionMgr->SendServerMessage(SERVER_MSG_STRING, ss.str().c_str());
             }
 
-            // Always send message on reward level up
-            if (isRewardLevel)
+            // Mensaje de recompensa (anuncio al servidor + aviso de banda al
+            // jugador). Con el premio en todos los niveles sale en cada subida,
+            // asi que se puede apagar: Congrats.RewardMessage.
+            if (isRewardLevel && col.rewardMessage)
             {
                 // Issue a server notification for the player on level up.
                 std::ostringstream ss;
@@ -282,6 +292,8 @@
             col.congratsAnnounce = sConfigMgr->GetOption<uint32>("Congrats.Announce", 1);
             col.congratsEnable = sConfigMgr->GetOption<uint32>("Congrats.Enable", 1);
             col.CongratsPerLevelEnable = sConfigMgr->GetOption<uint32>("CongratsPerLevel.Enable", 1);
+            col.rewardMessage = sConfigMgr->GetOption<uint32>("Congrats.RewardMessage", 1);
+            col.ignoreBots = sConfigMgr->GetOption<uint32>("Congrats.IgnoreBots", 1);
         }
