 RandomEnchants.EnchantChance3=60.0
+
+#
+#     RandomEnchants.ScaleWithLevel
+#        Anadido por patches/mod-random-enchants/01-level-scaled-tiers.patch.
+#        Limita el nivel del encantamiento al nivel del personaje: un personaje
+#        de nivel 12 no recibe un encantamiento de nivel 70.
+#        Default:     1 (activado)
+
+RandomEnchants.ScaleWithLevel = 1
+
+#
+#     RandomEnchants.Tier2MinLevel .. Tier5MinLevel
+#        Nivel minimo del personaje para cada tramo de encantamientos.
+#        Defaults:    20 / 40 / 60 / 71
+
+RandomEnchants.Tier2MinLevel = 20
+RandomEnchants.Tier3MinLevel = 40
+RandomEnchants.Tier4MinLevel = 60
+RandomEnchants.Tier5MinLevel = 71
