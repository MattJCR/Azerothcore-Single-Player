NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=acore_panel
DB_PASSWORD=cambia-esta-clave
AUTH_DATABASE=acore_auth
CHARACTERS_DATABASE=acore_characters
WORLD_DATABASE=acore_world
PANEL_DATABASE=acore_panel
REALM_ID=1
SESSION_SECRET=genera-al-menos-32-bytes-aleatorios
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=true
ADDONS_DIRECTORY=../cliente/Interface/AddOns
CLIENT_DATA_DIRECTORY=../cliente/Data
# SOAP: consola del worldserver, sólo 127.0.0.1:7878. Sin usuario/contraseña
# la moderación responde 503 en vez de fallar de forma opaca.
SOAP_HOST=127.0.0.1
SOAP_PORT=7878
SOAP_USERNAME=
SOAP_PASSWORD=
SOAP_TIMEOUT_MS=5000
# Modo en espera del worldserver (config.sh WORLDSERVER_STANDBY). Con "true" el
# panel muestra "en espera" en vez de "caído" cuando el worldserver está dormido.
WORLDSERVER_STANDBY=false
WORLDSERVER_STATE_PATH=/run/azerothcore/worldserver.state
